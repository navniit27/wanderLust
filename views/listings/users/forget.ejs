<% layout("layout/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Forget Password</h1>
    <div class="col-6 offset-3">
        <p class="text-muted">Enter your account email and we'll send a reset link.</p>
        <form action="/forget-password" method="POST" class="needs-validation" novalidate>
            <%- include("../../includes/csrf.ejs") %>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input name="email" id="email" type="email" class="form-control" autocomplete="email" required>
            </div>
            <button class="btn btn-success">Send reset link</button>
            <p class="mt-3 mb-0"><a href="/login">Back to login</a></p>
        </form>
    </div>
</div>
