<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>
        <%= err?.statusCode === 404 ? 'Page not found' : (err?.statusCode === 500 ? 'Server error' : 'Error') %> | WanderLust
    </title>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="alert alert-danger shadow-sm p-4" role="alert">
                    <h1 class="h4 alert-heading mb-2">
                        <% if (err?.statusCode === 404) { %>
                            Page not found
                        <% } else if (err?.statusCode >= 500) { %>
                            Something went wrong on our side
                        <% } else { %>
                            We couldn't complete that request
                        <% } %>
                    </h1>
                    <p class="mb-3">
                        <%= err?.message || "An unexpected error occurred." %>
                    </p>
                    <% if (err?.statusCode) { %>
                        <small class="text-muted">Error code: <%= err.statusCode %></small>
                    <% } %>
                </div>
                <div class="text-center mt-3 d-flex gap-2 justify-content-center flex-wrap">
                    <a href="/listings" class="btn btn-dark">Back to listings</a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary">Go back</a>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
