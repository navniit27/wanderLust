<% if (success && success.length) { %>
<div class="alert alert-success alert-dismissible fade show flash-alert col-12 col-md-10 col-lg-8 mx-auto" role="alert" data-flash-alert>
  <div class="d-flex align-items-center gap-2">
    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
    <span><%= success %></span>
  </div>
  <button type="button" class="btn-close" data-bs-dismiss="alert" data-flash-close aria-label="Close"></button>
</div>
<% } %>

<% if (error && error.length) { %>
<div class="alert alert-danger alert-dismissible fade show flash-alert col-12 col-md-10 col-lg-8 mx-auto" role="alert" data-flash-alert>
  <div class="d-flex align-items-center gap-2">
    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
    <span><%= error %></span>
  </div>
  <button type="button" class="btn-close" data-bs-dismiss="alert" data-flash-close aria-label="Close"></button>
</div>
<% } %>
