NODE_ENV=development
PORT=8080

# Use one database variable. ATLASDB_URL takes precedence when both are set.
ATLASDB_URL=mongodb+srv://username:password@cluster.mongodb.net/wanderlust
# MONGO_URL=mongodb://localhost:27017/wanderlust

# Use a long, randomly generated value in production.
SECRET=replace-with-a-long-random-session-secret

CLOUD_NAME=your-cloudinary-cloud-name
CLOUD_API_KEY=your-cloudinary-api-key
CLOUD_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=wanderlust_DEV
